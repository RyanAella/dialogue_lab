# Normalize line endings: store LF in the repo, checkout native on Windows.
* text=auto

# Explicitly text files (belt and braces for the common types)
*.js text
*.json text
*.md text
*.css text
*.html text
*.yml text
*.py text
*.txt text

# Binary assets - never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg binary
*.woff2 binary
*.woff binary
*.ttf binary
*.mp3 binary
*.wav binary
