<?php
// delete_dialogue.php
// Endpoint for counting and deleting ALL dialogue logs on the server.
//
// TWO-TOKEN MODEL (separation of concerns):
//   - Researcher URL tokens (see save_dialogue.php) have NO delete rights.
//   - One separate admin token authorizes the destructive actions below.
//
// Actions (POST, JSON body):
//   - count:      dry run, returns the number of stored dialogue files
//   - delete_all: irreversibly deletes all dialogue log files
//
// Frontend contract (src/js/features/researcherMenu.js):
//   - Header X-Admin-Token carries the admin token
//   - 403 = invalid admin token, 429 = rate limited

// =========================================================
// 1. CONFIGURATION: ADMIN TOKEN
//    Keep this token ONLY in your password manager.
//    Never put it into URLs, links or the researcher token list.
// =========================================================
$adminToken = 'XXXX'; // ← Insert your admin token here (server-side only)

// =========================================================
// 2. SECURITY: CORS for Dialogue Lab
// =========================================================
$allowed_origins = [
    "https://ryanaella.github.io",
    "http://localhost",
    "http://localhost:5500",
    "http://127.0.0.1:5500",
    "https://kite2.site"
];
$origin = $_SERVER['HTTP_ORIGIN'] ?? '';
if (in_array($origin, $allowed_origins)) {
    header("Access-Control-Allow-Origin: " . $origin);
} else {
    // Allow all localhost/127.0.0.1 requests for development
    if (strpos($origin, 'localhost') !== false || strpos($origin, '127.0.0.1') !== false) {
        header("Access-Control-Allow-Origin: " . $origin);
    } else {
        header("Access-Control-Allow-Origin: *");
    }
}

header("Access-Control-Allow-Methods: POST, OPTIONS");
header("Access-Control-Allow-Headers: Content-Type, X-Researcher-Token, X-Admin-Token");
header("Access-Control-Max-Age: 86400"); // 24h cache

if ($_SERVER['REQUEST_METHOD'] == 'OPTIONS') {
    http_response_code(200);
    exit;
}

header('Content-Type: application/json');

// =========================================================
// 3. RATE LIMIT (file-based, per IP)
//    Must run BEFORE token validation: it counts every attempt,
//    including invalid ones, so brute-force is actually throttled.
//    Requires a writable sys_get_temp_dir().
// =========================================================
$rateFile   = sys_get_temp_dir() . '/dl_delete_' . md5($_SERVER['REMOTE_ADDR'] ?? 'unknown') . '.json';
$rateWindow = 600; // 10 minutes
$rateMax    = 15;  // max requests per window (one delete run = count + delete_all)
$now = time();
$timestamps = [];
if (is_file($rateFile)) {
    $timestamps = array_filter(
        json_decode((string) file_get_contents($rateFile), true) ?: [],
        static function ($ts) use ($now, $rateWindow) {
            return is_numeric($ts) && ($now - (int) $ts) < $rateWindow;
        }
    );
    $timestamps = array_values($timestamps);
}
if (count($timestamps) >= $rateMax) {
    http_response_code(429);
    header('Retry-After: ' . $rateWindow);
    die(json_encode([
        'success' => false,
        'error' => 'Zu viele Versuche. Bitte später erneut versuchen.'
    ]));
}
$timestamps[] = $now;
file_put_contents($rateFile, json_encode($timestamps), LOCK_EX);

// =========================================================
// 4. ADMIN TOKEN VALIDATION (timing-safe)
//    The researcher token from the URL is NOT accepted here.
// =========================================================
$receivedAdminToken = $_SERVER['HTTP_X_ADMIN_TOKEN'] ?? '';

if ($adminToken === '' || !hash_equals($adminToken, (string) $receivedAdminToken)) {
    http_response_code(403);
    die(json_encode([
        'success' => false,
        'error' => 'Ungültiger Admin-Token',
        'hint' => 'Löschen erfordert den separaten Admin-Token (X-Admin-Token-Header)'
    ]));
}

// =========================================================
// 5. PARSE REQUEST / VALIDATE ACTION
// =========================================================
$jsonInput = file_get_contents('php://input');
$data = json_decode($jsonInput, true);

if ($data === null) {
    http_response_code(400);
    die(json_encode([
        'success' => false,
        'error' => 'Ungültige JSON-Daten empfangen',
        'hint' => json_last_error_msg()
    ]));
}

$action = $data['action'] ?? '';
if ($action !== 'count' && $action !== 'delete_all') {
    http_response_code(400);
    die(json_encode([
        'success' => false,
        'error' => 'Ungültige Action. Nur count und delete_all sind erlaubt.'
    ]));
}

// =========================================================
// 6. DIRECTORY WITH LOG FILES
// =========================================================
$logDir = __DIR__ . '/dialogue_logs';

// --- Action: count (dry run for the confirmation dialog) ---
if ($action === 'count') {
    $files = is_dir($logDir) ? glob($logDir . '/*.json') : [];
    if ($files === false) {
        $files = [];
    }
    $files = array_values(array_filter($files, 'is_file'));
    echo json_encode([
        'success' => true,
        'count' => count($files)
    ]);
    exit;
}

// --- Action: delete_all (irreversible) ---
if (!file_exists($logDir)) {
    http_response_code(200);
    die(json_encode([
        'success' => true,
        'message' => 'Keine Dialog-Dateien zum Löschen gefunden.',
        'deleted' => 0
    ]));
}

$files = glob($logDir . '/*.json');
if ($files === false) {
    $files = [];
}

// =========================================================
// 7. AUDIT LOG (written before the actual deletion)
//    Survives the deletion: lives next to, not inside, the log dir.
// =========================================================
$auditLine = date('c') . ' action=delete_all files=' . count($files) . ' ip=' . ($_SERVER['REMOTE_ADDR'] ?? 'unknown') . "\n";
file_put_contents(__DIR__ . '/delete_audit.log', $auditLine, FILE_APPEND | LOCK_EX);

// =========================================================
// 8. DELETE FILES
// =========================================================
$deletedCount = 0;
$errors = [];

foreach ($files as $file) {
    if (is_file($file)) {
        if (unlink($file)) {
            $deletedCount++;
        } else {
            $errors[] = basename($file);
        }
    }
}

// =========================================================
// 9. RESULT
// =========================================================
echo json_encode([
    'success' => true,
    'message' => 'Dialog-Dateien erfolgreich gelöscht',
    'deleted' => $deletedCount,
    'errors' => $errors
]);
