<?php
// save_dialogue.php
// Endpoint for saving dialogue data for research
// Saves each conversation as: {mode}_{scenario}_YYYY-MM-DD_HH-MM-SS.json
//
// DESIGN: Saving is open to all study participants (researcher token is
// optional and only recorded as metadata). Reading/deleting server data
// stays restricted: deletion requires the admin token (delete_dialogue.php),
// reading server data does not exist as an endpoint at all.
// Spam protection: mandatory Origin allowlist + file-based per-IP rate limit.

// =========================================================
// 2. SECURITY: CORS / Origin allowlist
//    (Access-Control-Allow-Origin goes out BEFORE the OPTIONS preflight exit)
// =========================================================
$allowed_origins = [
    "https://ryanaella.github.io",
    "http://localhost",
    "http://localhost:5500",
    "http://127.0.0.1",
    "http://127.0.0.1:5500",
    "https://kite2.site"
];

$origin = $_SERVER['HTTP_ORIGIN'] ?? '';

if ($origin !== '' && in_array($origin, $allowed_origins)) {
    header("Access-Control-Allow-Origin: " . $origin);
}

header("Access-Control-Allow-Methods: POST, OPTIONS");
header("Access-Control-Allow-Headers: Content-Type, X-Researcher-Token");
header("Access-Control-Max-Age: 86400"); // 24h cache

if (!in_array($origin, $allowed_origins)) {
    // Covers both a foreign origin and a missing Origin header (curl etc.)
    http_response_code(403);
    header('Content-Type: application/json');
    die(json_encode([
        'error' => 'Ungültige Origin. Zugriff nicht erlaubt.'
    ]));
}

if ($_SERVER['REQUEST_METHOD'] == 'OPTIONS') {
    http_response_code(200);
    exit;
}

header('Content-Type: application/json');

// =========================================================
// 3. RATE LIMIT (file-based, per IP)
//    Replaces the old session-based limit (ineffective: fetch requests
//    carry no session cookie, so the counter never accumulated).
//    Generous for study use and shared NAT IPs.
//    Requires a writable sys_get_temp_dir().
// =========================================================
$rateFile   = sys_get_temp_dir() . '/dl_save_' . md5($_SERVER['REMOTE_ADDR'] ?? 'unknown') . '.json';
$rateWindow = 600; // 10 minutes
$rateMax    = 60;
$now = time();
$timestamps = [];
if (is_file($rateFile)) {
    $timestamps = array_filter(
        json_decode((string) file_get_contents($rateFile), true) ?: [],
        static function ($ts) use ($now, $rateWindow) {
            return is_numeric($ts) && ($now - (int) $ts) < $rateWindow;
        }
    );
    $timestamps = array_values($timestamps);
}
if (count($timestamps) >= $rateMax) {
    http_response_code(429);
    header('Retry-Until: ' . $rateWindow);
    die(json_encode(['error' => 'Too many requests. Please wait a moment.']));
}
$timestamps[] = $now;
file_put_contents($rateFile, json_encode($timestamps), LOCK_EX);

// =========================================================
// PAYLOAD SIZE LIMIT
// =========================================================
$jsonInput = file_get_contents('php://input');
if (strlen($jsonInput) > 100000) { // Max 100KB
    http_response_code(413);
    die(json_encode(['error' => 'Payload too large']));
}

// =========================================================
// PROCESS DATA
// =========================================================
$data = json_decode($jsonInput, true);

if ($data === null) {
    http_response_code(400);
    die(json_encode([
        'error' => 'Ungültige JSON-Daten empfangen',
        'hint' => json_last_error_msg()
    ]));
}

if (!isset($data['conversationId'])) {
    http_response_code(400);
    die(json_encode(['error' => 'Fehlende conversationId']));
}

// =========================================================
// ADD METADATA FOR RESEARCH
// (token is recorded, NOT validated: participants have none)
// =========================================================
$receivedToken = $_SERVER['HTTP_X_RESEARCHER_TOKEN'] ?? 'anonymous';

$data['_uploadMetadata'] = [
    'uploadedAt' => date('c'),
    'token' => $receivedToken,
    'origin' => $_SERVER['HTTP_ORIGIN'] ?? 'unknown',
    'ip' => $_SERVER['REMOTE_ADDR'] ?? 'unknown'
];

// =========================================================
// GENERATE FILE NAME (user-friendly)
// =========================================================
// Extract and sanitize metadata
$mode = (!empty($data['metadata']['mode'])) ? strtolower($data['metadata']['mode']) : 'unknown';
$scenario = (!empty($data['metadata']['scenarioId'])) ? strtolower($data['metadata']['scenarioId']) : 'unknown';
$scenario = preg_replace('/[^a-z0-9_]/', '_', $scenario); // Replace special characters with _

// File name: mode_scenario_date_time.json
// Example: roleplay_job_interview_2026-07-21_09-15-23.json
$dateTime = date('Y-m-d_H-i-s'); // IMPORTANT: seconds for uniqueness
$filename = __DIR__ . '/dialogue_logs/' . $mode . '_' . $scenario . '_' . $dateTime . '.json';

// =========================================================
// CREATE DIRECTORY
// =========================================================
$logDir = __DIR__ . '/dialogue_logs';
if (!file_exists($logDir)) {
    if (!mkdir($logDir, 0755, true)) {
        http_response_code(500);
        die(json_encode(['error' => 'Kann Log-Verzeichnis nicht erstellen']));
    }
}

// =========================================================
// SAVE
// =========================================================
if (file_put_contents($filename, json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE)) === false) {
    http_response_code(500);
    die(json_encode(['error' => 'Kann Daten nicht speichern']));
}

// =========================================================
// SUCCESS
// =========================================================
echo json_encode([
    'success' => true,
    'message' => 'Dialogdaten erfolgreich gespeichert',
    'filename' => basename($filename),
    'conversationId' => $data['conversationId'],
    'savedAt' => date('c')
]);
