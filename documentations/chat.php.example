<?php
// chat.php
// Server-side proxy for the Dialogue Lab frontend to the LLM API.
// The API key never leaves the server.
//
// Hardening against abusive third-party use:
//   - Origin must match the allowlist (browser requests always send one;
//     plain curl/wget without Origin is rejected)
//   - File-based per-IP rate limit
//   - Model whitelist (must match APP_CONFIG.MODEL in the frontend)
//   - max_tokens cap and request size cap
//   - Payload is REBUILT from whitelisted fields only (raw client input
//     is never forwarded, so arbitrary API parameters cannot be injected)
//
// IMPORTANT: Access-Control-Allow-Origin must be sent BEFORE the
// OPTIONS preflight exit, otherwise the browser blocks the request.

// =========================================================
// 1. CONFIGURATION
// =========================================================
$api_key = 'XXXX'; // ← Insert your LLM API key here (server-side only)
$api_url = 'https://api.openai.com/v1/chat/completions';

// Must match APP_CONFIG.MODEL in src/js/core/config.js
$allowed_models = [
    'gpt-4o',
];

// Response token cap; always forced into the request
$max_tokens_cap = 1500;

// Discard oversized request bodies (default PHP limits still apply)
$max_body_bytes = 128 * 1024; // 128 KB

// Messages history cap (abuse and cost guard)
$max_messages = 80;

// =========================================================
// 2. SECURITY: CORS / Origin allowlist
// =========================================================
$allowed_origins = [
    "https://ryanaella.github.io",
    "http://localhost",
    "http://localhost:5500",
    "http://127.0.0.1",
    "http://127.0.0.1:5500",
    "https://kite2.site"
];

$origin = $_SERVER['HTTP_ORIGIN'] ?? '';

// Access-Control-Allow-Origin goes out BEFORE the OPTIONS preflight exit
if ($origin !== '' && in_array($origin, $allowed_origins)) {
    header("Access-Control-Allow-Origin: " . $origin);
}

header("Access-Control-Allow-Methods: POST, OPTIONS");
header("Access-Control-Allow-Headers: Content-Type");
header("Access-Control-Max-Age: 86400"); // 24h cache

if (!in_array($origin, $allowed_origins)) {
    // Covers both a foreign origin and a missing Origin header (curl etc.)
    http_response_code(403);
    header('Content-Type: application/json');
    die(json_encode([
        'error' => ['message' => 'Ungültige Origin. Zugriff nicht erlaubt.']
    ]));
}

if ($_SERVER['REQUEST_METHOD'] == 'OPTIONS') {
    http_response_code(200);
    exit;
}

header('Content-Type: application/json');

// =========================================================
// 3. RATE LIMIT (file-based, per IP)
//    Sized for study use: browsers share NAT IPs, so keep it generous.
//    Requires a writable sys_get_temp_dir().
// =========================================================
$rateFile   = sys_get_temp_dir() . '/dl_chat_' . md5($_SERVER['REMOTE_ADDR'] ?? 'unknown') . '.json';
$rateWindow = 600; // 10 minutes
$rateMax    = 100;
$now = time();
$timestamps = [];
if (is_file($rateFile)) {
    $timestamps = array_filter(
        json_decode((string) file_get_contents($rateFile), true) ?: [],
        static function ($ts) use ($now, $rateWindow) {
            return is_numeric($ts) && ($now - (int) $ts) < $rateWindow;
        }
    );
    $timestamps = array_values($timestamps);
}
if (count($timestamps) >= $rateMax) {
    http_response_code(429);
    header('Retry-After: ' . $rateWindow);
    die(json_encode([
        'error' => ['message' => 'Zu viele Anfragen. Bitte später erneut versuchen.']
    ]));
}
$timestamps[] = $now;
file_put_contents($rateFile, json_encode($timestamps), LOCK_EX);

// =========================================================
// 4. PARSE AND VALIDATE REQUEST
// =========================================================
if (strlen((string) file_get_contents('php://input')) > $max_body_bytes) {
    http_response_code(413);
    die(json_encode([
        'error' => ['message' => 'Request zu groß.']
    ]));
}

$jsonInput = file_get_contents('php://input');
$data = json_decode($jsonInput, true);

if (!is_array($data)) {
    http_response_code(400);
    die(json_encode([
        'error' => ['message' => 'Ungültige JSON-Daten empfangen.']
    ]));
}

// Model whitelist
if (!isset($data['model']) || !in_array($data['model'], $allowed_models, true)) {
    http_response_code(400);
    die(json_encode([
        'error' => ['message' => 'Modell nicht erlaubt.']
    ]));
}

// Message history must be a non-empty array with a sane length
if (!isset($data['messages']) || !is_array($data['messages']) || count($data['messages']) === 0) {
    http_response_code(400);
    die(json_encode([
        'error' => ['message' => 'Ungültige Nachrichten-Historie.']
    ]));
}
if (count($data['messages']) > $max_messages) {
    $data['messages'] = array_slice($data['messages'], -$max_messages);
}

// Temperature: numeric only, if sent
$temperature = null;
if (isset($data['temperature'])) {
    if (!is_numeric($data['temperature'])) {
        http_response_code(400);
        die(json_encode([
            'error' => ['message' => 'Ungültiger temperature-Wert.']
        ]));
    }
    $temperature = max(0.0, min(2.0, (float) $data['temperature']));
}

// =========================================================
// 5. REBUILD PAYLOAD (whitelisted fields only, never forward raw input)
// =========================================================
$payload = [
    'model' => $data['model'],
    'messages' => $data['messages'],
    'max_tokens' => $max_tokens_cap,
];
if ($temperature !== null) {
    $payload['temperature'] = $temperature;
}
$payloadJson = json_encode($payload);

// =========================================================
// 6. FORWARD TO LLM API
// =========================================================
$ch = curl_init($api_url);
curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
curl_setopt($ch, CURLOPT_POST, true);
curl_setopt($ch, CURLOPT_POSTFIELDS, $payloadJson);
curl_setopt($ch, CURLOPT_HTTPHEADER, [
    'Content-Type: application/json',
    'Authorization: Bearer ' . $api_key
]);
curl_setopt($ch, CURLOPT_CONNECTTIMEOUT, 20);
curl_setopt($ch, CURLOPT_TIMEOUT, 120);

$response = curl_exec($ch);
$httpCode = curl_getinfo($ch, CURLINFO_HTTP_CODE);

if (curl_errno($ch)) {
    http_response_code(502);
    echo json_encode(['error' => ['message' => curl_error($ch)]]);
} else {
    http_response_code($httpCode);
    echo $response;
}

curl_close($ch);
